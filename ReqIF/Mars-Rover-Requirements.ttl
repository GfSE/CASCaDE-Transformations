                                                                                                                                                                                              "MDReqIF_1712564283461_752038_19" ;
                                                                                                                                              rdfs:label "2.3.1 Max Motion Speed" .


###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947253_787088_17420
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947253_787088_17420> rdf:type owl:NamedIndividual ,
                                                                                                                                                        <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall be able to move on slopes which fullfill the following condition:
* slope angle uphill max. 20 degree
* slope angle downhill max. 30 degree
* slope angle sidehill max 15 degree""" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/identifier> "_17_0_3_1_60c0217_1554373947253_787088_17420" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/title> "Motion over slopes" ;
