                                                                                                                                               <http://purl.org/dc/elements/1.1/identifier> "_17_0_3_1_60c0217_1554373947238_606232_17414" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/title> "Motion Ground Contact" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/number> "2.3.4" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                               "MDReqIF_1712564283461_752038_19" ;
                                                                                                                                               rdfs:label "2.3.4 Motion Ground Contact" .


###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947238_635549_17411
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947238_635549_17411> rdf:type owl:NamedIndividual ,
                                                                                                                                                        <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall be able to move by itself over obstacles which fullfill one of the following condition:
* the obstacle is max. 20 cm high
* the slope angle uphil is max. 30 degree
* the slope angle downhil is max. 30 degree
* the roll angle of the Mars Rover since moving over the obstacle never exceeds an angle of 30 degree""" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/identifier> "_17_0_3_1_60c0217_1554373947238_635549_17411" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/title> "Motion over Obstacles" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/number> "2.3.2" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                               "MDReqIF_1712564283461_752038_19" ;
                                                                                                                                               rdfs:label "2.3.2 Motion over Obstacles" .


###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947253_22759_17417
