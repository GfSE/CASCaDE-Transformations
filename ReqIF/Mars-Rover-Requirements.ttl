###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710150476050_13127_5658
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710150476050_13127_5658> rdf:type owl:NamedIndividual ,
                                                                                                                                                     <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                            <http://purl.org/dc/elements/1.1/description> "The Mars Rover shall resist temperatures of not more than 100°C for not more than 7 minutes while staying full functional." ;
                                                                                                                                            <http://purl.org/dc/elements/1.1/identifier> "_2021x_2_8d501e7_1710150476050_13127_5658" ;
                                                                                                                                            <http://purl.org/dc/elements/1.1/title> "Landing Temperatures" ;
                                                                                                                                            <http://www.omg.org/spec/CASCaRA/ontology/number> "2.8.1" ;
                                                                                                                                            <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                            "MDReqIF_1712564283513_737771_74" ;
                                                                                                                                            rdfs:label "2.8.1 Landing Temperatures" .


###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710150561344_954069_5661
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710150561344_954069_5661> rdf:type owl:NamedIndividual ,
                                                                                                                                                      <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall be able to withstand landing deceleration as listed below:
* Deceleration from 20.000 km/h at Mars atmosphere entry to 1.500 km/h in 4 minutes.
* Deceleration from 1.500 km/s to 25 m/s in 3 minutes""" ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/identifier> "_2021x_2_8d501e7_1710150561344_954069_5661" ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/title> "Landing Deceleration" ;
                                                                                                                                             <http://www.omg.org/spec/CASCaRA/ontology/number> "2.8.2" ;
                                                                                                                                             <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                             "MDReqIF_1712564283513_737771_74" ;
                                                                                                                                             rdfs:label "2.8.2 Landing Deceleration" .


###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710150880576_958104_5666
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710150880576_958104_5666> rdf:type owl:NamedIndividual ,
                                                                                                                                                      <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall be full operable after a landing on Mars with the following conditions beeing true:
* The vertical speed at ground contact is not higher than 1 m/s
* The horizontal speed at graund contact is not higher than 1 m/s""" ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/identifier> "_2021x_2_8d501e7_1710150880576_958104_5666" ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/title> "Landing speed" ;
                                                                                                                                             <http://www.omg.org/spec/CASCaRA/ontology/number> "2.8.3" ;
                                                                                                                                             <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                             "MDReqIF_1712564283513_737771_74" ;
                                                                                                                                             rdfs:label "2.8.3 Landing speed" .


###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710151377993_602525_5676
