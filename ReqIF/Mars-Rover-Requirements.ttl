###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947269_80329_17517
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947269_80329_17517> rdf:type owl:NamedIndividual ,
                                                                                                                                                       <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                              <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall re-charge the energy storage from 10% to 80% in 4h under the following conditions:
* re-charging at mission normal conditions
* no energy consumption of the Mars Rover since the re-charging period""" ;
                                                                                                                                              <http://purl.org/dc/elements/1.1/identifier> "_17_0_3_1_60c0217_1554373947269_80329_17517" ;
                                                                                                                                              <http://purl.org/dc/elements/1.1/title> "Energy Re-Charging" ;
                                                                                                                                              <http://www.omg.org/spec/CASCaRA/ontology/number> "2.2.3" ;
                                                                                                                                              <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                              "MDReqIF_1712564283461_752038_19" ;
                                                                                                                                              rdfs:label "2.2.3 Energy Re-Charging" .


###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947269_839759_17516
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373947269_839759_17516> rdf:type owl:NamedIndividual ,
                                                                                                                                                        <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall have a power supply fulfilling all of the following conditions:
* it contains an energy storage system
* it contains an energy management system
* it contains a power distribution system""" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/identifier> "_17_0_3_1_60c0217_1554373947269_839759_17516" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/title> "Internal Power Supply" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/number> "2.2.2" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                               "MDReqIF_1712564283446_317325_10" ;
                                                                                                                                               rdfs:label "2.2.2 Internal Power Supply" .


###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373992768_101922_18958
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373992768_101922_18958> rdf:type owl:NamedIndividual ,
                                                                                                                                                        <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall be operable for 4h under all of the following conditions:
* The energy storage is fully loaded at the beginning
* The operation requires less than or equal to 60% of the max energy in peak load
* the environmental conditions are mission normal""" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/identifier> "_17_0_3_1_60c0217_1554373992768_101922_18958" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/title> "Available Power" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/number> "2.2.2.2" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                               "MDReqIF_1712564283446_317325_10" ;
                                                                                                                                               rdfs:label "2.2.2.2 Available Power" .


