                                                                                                                                                      <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/description> "The Mars Rover shall be able to land on planet Mars." ;
