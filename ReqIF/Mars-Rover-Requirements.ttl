                                                                                                                                                      <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall be able to execute the following operations individually and not in combination:
* Moving on Mars surface
* Capturing optical information
* Capturing video information
* Capturing audio information
* Sampling of Probes of solid material of individual diameter not bigger than 20 mm
* Sampling of probes of fluid material in the range of ph-value 0 to 11
* Sampling of probes of gas of not more than 50 mm³ volume and pressure between 1 hPa up to 3.000 hPa
* Sampling of biological probes of not more than 50 mm³ volume and not more than 30 mm length in any direction""" ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/identifier> "_2021x_2_8d501e7_1710152920321_382759_5749" ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/title> "Mars Rover Capabilities" ;
                                                                                                                                             <http://www.omg.org/spec/CASCaRA/ontology/number> "2.7" ;
                                                                                                                                             <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                             "MDReqIF_1712564283461_752038_19" ;
                                                                                                                                             rdfs:label "2.7 Mars Rover Capabilities" .


