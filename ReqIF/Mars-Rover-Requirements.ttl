###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373886850_551019_15911
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_17_0_3_1_60c0217_1554373886850_551019_15911> rdf:type owl:NamedIndividual ,
                                                                                                                                                        <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall have an energy management fullfilling all of the following conditions:
* distributing the energy to all systems
* prioritizing the energy available for the different systems
* limiting energy to individual systems to prioritize individual systems
* managing energy that the Mars Rover can recharge by itself in a time period of less than 24 hours""" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/identifier> "_17_0_3_1_60c0217_1554373886850_551019_15911" ;
                                                                                                                                               <http://purl.org/dc/elements/1.1/title> "Energy Management" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/number> "2.2.4" ;
                                                                                                                                               <http://www.omg.org/spec/CASCaRA/ontology/type> "" ,
                                                                                                                                                                                               "MDReqIF_1712564283461_752038_19" ;
                                                                                                                                               rdfs:label "2.2.4 Energy Management" .


