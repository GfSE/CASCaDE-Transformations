###  file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710148844988_144183_5599
<file:/D:/Projekte/Prostep_iViP/CASCaRA/40_Realisierung/Submission/CASCaDE-Transformations/ReqIF/_2021x_2_8d501e7_1710148844988_144183_5599> rdf:type owl:NamedIndividual ,
                                                                                                                                                      <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/description> """The Mars Rover shall prevent driving over obstacles if all of the following conditions are true:
* the obstacle exceeds the measures of an acceptable obstacle as required in 1.1.3.2
* a rout is available around the obstacle or rearwards to a position capable to reach the target without crossing the obstacle.""" ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/identifier> "_2021x_2_8d501e7_1710148844988_144183_5599" ;
                                                                                                                                             <http://purl.org/dc/elements/1.1/title> "Preventing Obstacles" ;
