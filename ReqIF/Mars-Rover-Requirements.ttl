                                                                                                                                                       <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/Requirement> ;
                                                                                                                                              <http://purl.org/dc/elements/1.1/description> "The Mars Rover shall be able to move by itself with a max. speed of 7 m/s." ;
                                                                                                                                              <http://purl.org/dc/elements/1.1/identifier> "_17_0_3_1_60c0217_1554373947253_22759_17417" ;
                                                                                                                                              <http://purl.org/dc/elements/1.1/title> "Max Motion Speed" ;
