		<type>MDReqIF_1712564283421_181534_4</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373833970_87496_14528">
		<dc:identifier>_17_0_3_1_60c0217_1554373833970_87496_14528</dc:identifier>
		<number>2</number>
		<dc:title>Technical requirements</dc:title>
		<dc:description></dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373894872_831523_16027">
		<dc:identifier>_17_0_3_1_60c0217_1554373894872_831523_16027</dc:identifier>
		<number>2.1</number>
		<dc:title>Structure</dc:title>
		<dc:description></dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373947269_619833_17513">
		<dc:identifier>_17_0_3_1_60c0217_1554373947269_619833_17513</dc:identifier>
		<number>2.1.1</number>
		<dc:title>Head</dc:title>
		<dc:description>The Mars Rover shall have a head</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710152799440_775076_5744">
		<dc:identifier>_2021x_2_8d501e7_1710152799440_775076_5744</dc:identifier>
		<number>2.1.1.1</number>
		<dc:title>Head Position</dc:title>
		<dc:description>The Head of the Mars Rover shall be higher mounted than body, suspension and traction unit.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710153330085_930613_5754">
		<dc:identifier>_2021x_2_8d501e7_1710153330085_930613_5754</dc:identifier>
		<number>2.1.1.2</number>
		<dc:title>Head Function</dc:title>
		<dc:description>The Head of the Mars Rover shall carry sensors and a LED Display.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710146462874_714909_5562">
		<dc:identifier>_2021x_2_8d501e7_1710146462874_714909_5562</dc:identifier>
		<number>2.1.2</number>
		<dc:title>Body</dc:title>
		<dc:description>The Mars Rover shall have a body</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710146492047_939247_5565">
		<dc:identifier>_2021x_2_8d501e7_1710146492047_939247_5565</dc:identifier>
		<number>2.1.3</number>
		<dc:title>Suspension</dc:title>
		<dc:description>The Mars Rover shall have a suspension suspending the traction unit</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710146526694_117941_5568">
		<dc:identifier>_2021x_2_8d501e7_1710146526694_117941_5568</dc:identifier>
		<number>2.1.4</number>
		<dc:title>Traction Unit</dc:title>
		<dc:description>The Mars Rover shall have a traction unit providing traction to the ground</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373894872_990229_16028">
		<dc:identifier>_17_0_3_1_60c0217_1554373894872_990229_16028</dc:identifier>
		<number>2.2</number>
		<dc:title>Power Supply</dc:title>
		<dc:description>The Mars Rover shall have a power supply.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373947269_334692_17515">
		<dc:identifier>_17_0_3_1_60c0217_1554373947269_334692_17515</dc:identifier>
		<number>2.2.1</number>
		<dc:title>External Power Supply</dc:title>
		<dc:description>The Mars Rover shall be operable with internal power supply only.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373947269_839759_17516">
		<dc:identifier>_17_0_3_1_60c0217_1554373947269_839759_17516</dc:identifier>
		<number>2.2.2</number>
		<dc:title>Internal Power Supply</dc:title>
		<dc:description>The Mars Rover shall have a power supply fulfilling all of the following conditions:
* it contains an energy storage system
* it contains an energy management system
* it contains a power distribution system</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373992768_924005_18953">
		<dc:identifier>_17_0_3_1_60c0217_1554373992768_924005_18953</dc:identifier>
		<number>2.2.2.1</number>
		<dc:title>Energy Storage</dc:title>
		<dc:description>The Mars Rover shall have means to re-charde its energy storage system.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373992768_101922_18958">
		<dc:identifier>_17_0_3_1_60c0217_1554373992768_101922_18958</dc:identifier>
		<number>2.2.2.2</number>
		<dc:title>Available Power</dc:title>
		<dc:description>The Mars Rover shall be operable for 4h under all of the following conditions:
* The energy storage is fully loaded at the beginning
* The operation requires less than or equal to 60% of the max energy in peak load
* the environmental conditions are mission normal</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373947269_80329_17517">
		<dc:identifier>_17_0_3_1_60c0217_1554373947269_80329_17517</dc:identifier>
		<number>2.2.3</number>
		<dc:title>Energy Re-Charging</dc:title>
		<dc:description>The Mars Rover shall re-charge the energy storage from 10% to 80% in 4h under the following conditions:
* re-charging at mission normal conditions
* no energy consumption of the Mars Rover since the re-charging period</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373886850_739640_15912">
		<dc:identifier>_17_0_3_1_60c0217_1554373886850_739640_15912</dc:identifier>
		<number>2.2.5</number>
		<dc:title>Electrical Values</dc:title>
		<dc:description>The Mars Rover shall use 12 V DC voltage</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1555340930579_881851_34234">
		<dc:identifier>_17_0_3_1_60c0217_1555340930579_881851_34234</dc:identifier>
		<number>2.2.5.1</number>
		<dc:title>Motor Voltage</dc:title>
		<dc:description>The Mars Rover shall have one main drive motor for each traction device fulfilling the following conditions:
* using 12 V voltage
* using not more than 30 A current</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2022x_8a9027b_1707924576905_883240_5487">
		<dc:identifier>_2022x_8a9027b_1707924576905_883240_5487</dc:identifier>
		<number>2.2.5.2</number>
		<dc:title>Encoder Voltage</dc:title>
		<dc:description>The Mars Rover shall have an encoder powered by 5 V voltage.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373886850_551019_15911">
		<dc:identifier>_17_0_3_1_60c0217_1554373886850_551019_15911</dc:identifier>
		<number>2.2.4</number>
		<dc:title>Energy Management</dc:title>
		<dc:description>The Mars Rover shall have an energy management fullfilling all of the following conditions:
* distributing the energy to all systems
* prioritizing the energy available for the different systems
* limiting energy to individual systems to prioritize individual systems
* managing energy that the Mars Rover can recharge by itself in a time period of less than 24 hours</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373894872_489031_16029">
		<dc:identifier>_17_0_3_1_60c0217_1554373894872_489031_16029</dc:identifier>
		<number>2.3</number>
		<dc:title>Motion</dc:title>
		<dc:description>The Mars Rover shall be able to move by itself.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373947238_635549_17411">
		<dc:identifier>_17_0_3_1_60c0217_1554373947238_635549_17411</dc:identifier>
		<number>2.3.2</number>
		<dc:title>Motion over Obstacles</dc:title>
		<dc:description>The Mars Rover shall be able to move by itself over obstacles which fullfill one of the following condition:
* the obstacle is max. 20 cm high
* the slope angle uphil is max. 30 degree
* the slope angle downhil is max. 30 degree
* the roll angle of the Mars Rover since moving over the obstacle never exceeds an angle of 30 degree</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2022x_8a9027b_1708424764583_139395_5943">
		<dc:identifier>_2022x_8a9027b_1708424764583_139395_5943</dc:identifier>
		<number>2.3.2.1</number>
		<dc:title>Deformation of the bogie</dc:title>
		<dc:description>The bogie of the suspension system shall not bend more than 5% since all motion events.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710147594026_511625_5572">
		<dc:identifier>_2021x_2_8d501e7_1710147594026_511625_5572</dc:identifier>
		<number>2.3.2.2</number>
		<dc:title>Plastic deformation of the bogie</dc:title>
		<dc:description>The bogie of the suspension system shall not deform plastically for bending less than or equal to 7%.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373947238_606232_17414">
		<dc:identifier>_17_0_3_1_60c0217_1554373947238_606232_17414</dc:identifier>
		<number>2.3.4</number>
		<dc:title>Motion Ground Contact</dc:title>
		<dc:description>The Mars Rover shall produce a ground pressure of max. 20 kPa.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373947253_22759_17417">
		<dc:identifier>_17_0_3_1_60c0217_1554373947253_22759_17417</dc:identifier>
		<number>2.3.1</number>
		<dc:title>Max Motion Speed</dc:title>
		<dc:description>The Mars Rover shall be able to move by itself with a max. speed of 7 m/s.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373947253_787088_17420">
		<dc:identifier>_17_0_3_1_60c0217_1554373947253_787088_17420</dc:identifier>
		<number>2.3.3</number>
		<dc:title>Motion over slopes</dc:title>
		<dc:description>The Mars Rover shall be able to move on slopes which fullfill the following condition:
* slope angle uphill max. 20 degree
* slope angle downhill max. 30 degree
* slope angle sidehill max 15 degree</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373888774_76355_15935">
		<dc:identifier>_17_0_3_1_60c0217_1554373888774_76355_15935</dc:identifier>
		<number>2.3.5</number>
		<dc:title>Electric Motion Drive</dc:title>
		<dc:description>The Mars Rover shall have one left and one right traction device both driven by one electrical motor each.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373888774_384276_15938">
		<dc:identifier>_17_0_3_1_60c0217_1554373888774_384276_15938</dc:identifier>
		<number>2.3.8</number>
		<dc:title>Motion Distance</dc:title>
		<dc:description>The Mars Rover shall be able to move at least 100m per day on all slopes where it is able to move on.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373888774_923366_15937">
		<dc:identifier>_17_0_3_1_60c0217_1554373888774_923366_15937</dc:identifier>
		<number>2.3.7</number>
		<dc:title>Min Motion Speed</dc:title>
		<dc:description>The Mars Rover shall be able to move by itself with a min. speed of 1 m/min</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373888774_941195_15936">
		<dc:identifier>_17_0_3_1_60c0217_1554373888774_941195_15936</dc:identifier>
		<number>2.3.6</number>
		<dc:title>Start Driving</dc:title>
		<dc:description>The Mars Rover shall start driving by itself on all slopes where it is able to move on.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1555336591336_85392_31015">
		<dc:identifier>_17_0_3_1_60c0217_1555336591336_85392_31015</dc:identifier>
		<number>2.3.9</number>
		<dc:title>Stopping</dc:title>
		<dc:description>The Mars Rover shall be able to stop moving by itself down to 0 m/s speed.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710148366772_438416_5581">
		<dc:identifier>_2021x_2_8d501e7_1710148366772_438416_5581</dc:identifier>
		<number>2.3.10</number>
		<dc:title>Hill Holding</dc:title>
		<dc:description>The Mars Rover shall maintain 0 m/s motion on all slopes it is able to move on.
</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710148561688_473742_5584">
		<dc:identifier>_2021x_2_8d501e7_1710148561688_473742_5584</dc:identifier>
		<number>2.3.11</number>
		<dc:title>Steering</dc:title>
		<dc:description>The Mars Rover shall be able to change driving direction to the left and to the right.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710148601847_750005_5587">
		<dc:identifier>_2021x_2_8d501e7_1710148601847_750005_5587</dc:identifier>
		<number>2.3.12</number>
		<dc:title>Diving Direction</dc:title>
		<dc:description>The Mars Rover shall be able to drive forwards and backwards.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710148650016_796202_5590">
		<dc:identifier>_2021x_2_8d501e7_1710148650016_796202_5590</dc:identifier>
		<number>2.3.13</number>
		<dc:title>Navigate</dc:title>
		<dc:description>The Mars Rover shall be able to calculate a route between its actual position and a target position</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710148712446_394547_5593">
		<dc:identifier>_2021x_2_8d501e7_1710148712446_394547_5593</dc:identifier>
		<number>2.3.13.1</number>
		<dc:title>Detecting Obstacles</dc:title>
		<dc:description>The Mars Rover shall be able to identify obstacles by itself</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710148782585_264451_5596">
		<dc:identifier>_2021x_2_8d501e7_1710148782585_264451_5596</dc:identifier>
		<number>2.3.13.2</number>
		<dc:title>Map Data</dc:title>
		<dc:description>The Mars Rover shall have map data stored enabling it to calculate a route between its actual position and a target position</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710148844988_144183_5599">
		<dc:identifier>_2021x_2_8d501e7_1710148844988_144183_5599</dc:identifier>
		<number>2.3.13.3</number>
		<dc:title>Preventing Obstacles</dc:title>
		<dc:description>The Mars Rover shall prevent driving over obstacles if all of the following conditions are true:
* the obstacle exceeds the measures of an acceptable obstacle as required in 1.1.3.2
* a rout is available around the obstacle or rearwards to a position capable to reach the target without crossing the obstacle.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373894872_844710_16030">
		<dc:identifier>_17_0_3_1_60c0217_1554373894872_844710_16030</dc:identifier>
		<number>2.4</number>
		<dc:title>Remote Control</dc:title>
		<dc:description>The Mars Rover shall be controllable remote.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373888790_510287_15941">
		<dc:identifier>_17_0_3_1_60c0217_1554373888790_510287_15941</dc:identifier>
		<number>2.4.2</number>
		<dc:title>Remote Steering</dc:title>
		<dc:description>The Mars Rover steering direction shall be controllable remote.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373888774_288492_15940">
		<dc:identifier>_17_0_3_1_60c0217_1554373888774_288492_15940</dc:identifier>
		<number>2.4.1</number>
		<dc:title>Remote Speed Control</dc:title>
		<dc:description>The Mars Rover speed shall be controllable remote.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710149292477_668117_5602">
		<dc:identifier>_2021x_2_8d501e7_1710149292477_668117_5602</dc:identifier>
		<number>2.4.3</number>
		<dc:title>Remote Control Priority</dc:title>
		<dc:description>The Mars Rover remote control shall be able to overrule the auto navigation function.</dc:description>
		<type>MDReqIF_1712564283503_898570_59</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373894872_183392_16031">
		<dc:identifier>_17_0_3_1_60c0217_1554373894872_183392_16031</dc:identifier>
		<number>2.5</number>
		<dc:title>Optical Feedback</dc:title>
		<dc:description>The Mars Rover shall provide optical information if it is operable or not.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373890795_302548_15964">
		<dc:identifier>_17_0_3_1_60c0217_1554373890795_302548_15964</dc:identifier>
		<number>2.5.1</number>
		<dc:title>LED</dc:title>
		<dc:description>The Mars Rover shall have a LED for optical information if it is operable or not.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_17_0_3_1_60c0217_1554373894872_124599_16032">
		<dc:identifier>_17_0_3_1_60c0217_1554373894872_124599_16032</dc:identifier>
		<number>2.6</number>
		<dc:title>Max Mass</dc:title>
		<dc:description>The Mars Rover shall have a total mass of not more than 12 kg</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710153834097_967050_5805">
		<dc:identifier>_2021x_2_8d501e7_1710153834097_967050_5805</dc:identifier>
		<number>2.6.1</number>
		<dc:title>Mars Rover Mass</dc:title>
		<dc:description>The Mars Rover shall have a total mass of not more than 10 kg</dc:description>
		<type>MDReqIF_1712564283503_898570_59</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710153885017_514661_5808">
		<dc:identifier>_2021x_2_8d501e7_1710153885017_514661_5808</dc:identifier>
		<number>2.6.2</number>
		<dc:title>Payload</dc:title>
		<dc:description>The Mars Rover shall have a payload of 2 kg.</dc:description>
		<type>MDReqIF_1712564283446_317325_10</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710152920321_382759_5749">
		<dc:identifier>_2021x_2_8d501e7_1710152920321_382759_5749</dc:identifier>
		<number>2.7</number>
		<dc:title>Mars Rover Capabilities</dc:title>
		<dc:description>The Mars Rover shall be able to execute the following operations individually and not in combination:
* Moving on Mars surface
* Capturing optical information
* Capturing video information
* Capturing audio information
* Sampling of Probes of solid material of individual diameter not bigger than 20 mm
* Sampling of probes of fluid material in the range of ph-value 0 to 11
* Sampling of probes of gas of not more than 50 mm³ volume and pressure between 1 hPa up to 3.000 hPa
* Sampling of biological probes of not more than 50 mm³ volume and not more than 30 mm length in any direction</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710153615080_304380_5787">
		<dc:identifier>_2021x_2_8d501e7_1710153615080_304380_5787</dc:identifier>
		<number>2.7.1</number>
		<dc:title>Mars Rover Communication</dc:title>
		<dc:description>The Mars Rover shall be able to communicate sampled information to the Mars station.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710153678770_496381_5792">
		<dc:identifier>_2021x_2_8d501e7_1710153678770_496381_5792</dc:identifier>
		<number>2.7.2</number>
		<dc:title>Information Storage</dc:title>
		<dc:description>The Mars Rover shall be capable to store information up to 2 TB</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710153727491_409919_5797">
		<dc:identifier>_2021x_2_8d501e7_1710153727491_409919_5797</dc:identifier>
		<number>2.7.3</number>
		<dc:title>Sample Storage</dc:title>
		<dc:description>The Mars Rover shall be able to store probes up to 48 h long.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710153776399_96192_5800">
		<dc:identifier>_2021x_2_8d501e7_1710153776399_96192_5800</dc:identifier>
		<number>2.7.4</number>
		<dc:title>Unloading</dc:title>
		<dc:description>The Mars Rover shall be able to unload stored probes into the Mars Station.</dc:description>
		<type>MDReqIF_1712564283461_752038_19</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710151635216_154098_5695">
		<dc:identifier>_2021x_2_8d501e7_1710151635216_154098_5695</dc:identifier>
		<number>2.9</number>
		<dc:title>Operating on Mars</dc:title>
		<dc:description>The Mars Rover shall be able to operate on the planet Mars.</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710151675649_994932_5700">
		<dc:identifier>_2021x_2_8d501e7_1710151675649_994932_5700</dc:identifier>
		<number>2.9.1</number>
		<dc:title>Operating Atmosphere</dc:title>
		<dc:description>The Mars Rover shall be able to operate in Mars atmosphere for at least 25 years.</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710151718558_644987_5705">
		<dc:identifier>_2021x_2_8d501e7_1710151718558_644987_5705</dc:identifier>
		<number>2.9.2</number>
		<dc:title>Mars Gravity</dc:title>
		<dc:description>The Mars Rover shall be able to operate under Mars gravity of 3.71 m/s².</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710151896250_201297_5710">
		<dc:identifier>_2021x_2_8d501e7_1710151896250_201297_5710</dc:identifier>
		<number>2.9.3</number>
		<dc:title>Mars Temperatures</dc:title>
		<dc:description>The Mars Rover shall be able to operate in a temperature range from -80°C up to 80°C</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710152037892_253674_5713">
		<dc:identifier>_2021x_2_8d501e7_1710152037892_253674_5713</dc:identifier>
		<number>2.9.4</number>
		<dc:title>Mars Radiation</dc:title>
		<dc:description>The Mars Rover shall be able to be fully operable under constant cosmic radiation of at least 250 mSv.</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710150433825_282917_5653">
		<dc:identifier>_2021x_2_8d501e7_1710150433825_282917_5653</dc:identifier>
		<number>2.8</number>
		<dc:title>Landing on Mars</dc:title>
		<dc:description>The Mars Rover shall be able to land on planet Mars.</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710150476050_13127_5658">
		<dc:identifier>_2021x_2_8d501e7_1710150476050_13127_5658</dc:identifier>
		<number>2.8.1</number>
		<dc:title>Landing Temperatures</dc:title>
		<dc:description>The Mars Rover shall resist temperatures of not more than 100°C for not more than 7 minutes while staying full functional.</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710150561344_954069_5661">
		<dc:identifier>_2021x_2_8d501e7_1710150561344_954069_5661</dc:identifier>
		<number>2.8.2</number>
		<dc:title>Landing Deceleration</dc:title>
		<dc:description>The Mars Rover shall be able to withstand landing deceleration as listed below:
* Deceleration from 20.000 km/h at Mars atmosphere entry to 1.500 km/h in 4 minutes.
* Deceleration from 1.500 km/s to 25 m/s in 3 minutes</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710150880576_958104_5666">
		<dc:identifier>_2021x_2_8d501e7_1710150880576_958104_5666</dc:identifier>
		<number>2.8.3</number>
		<dc:title>Landing speed</dc:title>
		<dc:description>The Mars Rover shall be full operable after a landing on Mars with the following conditions beeing true:
* The vertical speed at ground contact is not higher than 1 m/s
* The horizontal speed at graund contact is not higher than 1 m/s</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
	<arch:Requirement rdf:about="_2021x_2_8d501e7_1710151377993_602525_5676">
		<dc:identifier>_2021x_2_8d501e7_1710151377993_602525_5676</dc:identifier>
		<number>2.8.4</number>
		<dc:title>Landing Orientation</dc:title>
		<dc:description>The Mars Rover shall land on Mars with the traction units first contacting the ground.</dc:description>
		<type>MDReqIF_1712564283513_737771_74</type>
		<type></type>
	</arch:Requirement>
